{
  "name": "snipbox",
  "version": "1.0.0",
  "description": "A small pastebin for code with server-side syntax highlighting, expiry and burn-after-read",
  "main": "dist/server.js",
  "scripts": {
    "test": "vitest run",
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "dev": "npm run build && node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.4",
    "nanoid": "^6.0.2",
    "shiki": "^4.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  }
}
